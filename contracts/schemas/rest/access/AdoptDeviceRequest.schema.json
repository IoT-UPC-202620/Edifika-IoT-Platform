{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdoptDeviceRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "deviceType": {
      "type": "string",
      "enum": [
        "DOOR"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "RFID",
          "LOCK",
          "BUZZER",
          "OLED",
          "RGB_LED",
          "TEMPERATURE",
          "HUMIDITY"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "unlockSeconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "name",
    "location",
    "deviceType",
    "capabilities",
    "unlockSeconds"
  ],
  "additionalProperties": false
}
