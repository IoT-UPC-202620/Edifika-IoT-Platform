{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MQTT Announce Message",
  "description": "Un nodo se anuncia al conectarse y, mientras no está adoptado, cada 60 s. El gateway lo registra como pendiente; un nodo pendiente es totalmente inerte.",
  "type": "object",
  "properties": {
    "v": {
      "type": [
        "integer",
        "string"
      ],
      "enum": [
        1,
        "1"
      ]
    },
    "ts": {
      "type": [
        "integer",
        "number",
        "string",
        "null"
      ]
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "mac": {
      "type": "string",
      "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
    },
    "fw": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "RFID",
          "LOCK",
          "BUZZER",
          "OLED",
          "RGB_LED",
          "TEMPERATURE",
          "HUMIDITY"
        ]
      },
      "uniqueItems": true
    },
    "ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "rssi": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pairingCode": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    }
  },
  "required": [
    "v",
    "deviceId",
    "mac",
    "fw",
    "capabilities",
    "pairingCode"
  ],
  "additionalProperties": true
}
