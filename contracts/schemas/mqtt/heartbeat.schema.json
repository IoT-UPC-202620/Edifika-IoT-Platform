{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MQTT Heartbeat Message",
  "type": "object",
  "properties": {
    "v": {
      "type": [
        "integer",
        "string"
      ],
      "enum": [
        1,
        "1"
      ]
    },
    "ts": {
      "type": [
        "integer",
        "number",
        "string",
        "null"
      ]
    },
    "deviceId": {
      "type": "string"
    },
    "fw": {
      "type": "string"
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FREE_ACCESS",
        "RESERVED",
        null
      ],
      "description": "Door mode the node currently shows; the gateway re-sends `mode` when it differs from the latest configuration"
    },
    "color": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "LED colour shown while RESERVED; null otherwise"
    }
  },
  "required": [
    "v",
    "ts",
    "deviceId"
  ],
  "additionalProperties": true
}
